# Supabase (samo server, nikad NEXT_PUBLIC_)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Javna adresa stranice, za linkove izazova (bez kose crte na kraju)
POSTO_SITE_URL=https://tvoja-domena.hr

# Datum prvog računa (YYYY-MM-DD, po zagrebačkom vremenu)
POSTO_POCETAK=2026-11-16

# Sol za sažetak IP adrese kod ograničenja zahtjeva (bilo koji dugi nasumični niz)
POSTO_SOL=

# Podaci za stranicu /privatnost
POSTO_VODITELJ=
POSTO_KONTAKT=

# Samo za lokalni razvoj bez Supabasea: podaci u memoriji procesa, nestaju pri restartu
# POSTO_MEMORIJA=1
